// Config for markdownlint-cli2 (see https://github.com/DavidAnson/markdownlint-cli2).
// Fenced code is exempt from line length: the README embeds pasted
// --help output, which must not be re-wrapped.
{
    "default": true,
    "MD013": {
        "code_blocks": false,
        "tables": false
    },
    "MD024": {
        "siblings_only": true
    },
    "MD033": false,
    "ignores": [
        "compare/COMPARISON.md",
        "compare/STYLES-DESIGN.md",
        "compare/TASKLISTS-DESIGN.md"
    ]
}
