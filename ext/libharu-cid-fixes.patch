+/* Destination of a bfchar entry for a codepoint beyond the BMP: its
+ * UTF-16 surrogate pair, written as one <8-hex-digit> token. */
+static char*
+AlternateDstToHex  (char        *buf,
+                    HPDF_UINT32  codepoint,
+                    char        *eptr)
+{
+    static const char hexdig[] = "0123456789ABCDEF";
+    HPDF_UINT32 tail = codepoint - 0x10000;
+    HPDF_UINT16 surrogates[2];
+    char *pbuf = buf;
+    int i, j;
+
+    surrogates[0] = (HPDF_UINT16)(0xD800 + (tail >> 10));
+    surrogates[1] = (HPDF_UINT16)(0xDC00 + (tail & 0x3FF));
+
+    if (eptr - buf < 11)
+        return buf;
+
+    *pbuf++ = '<';
+    for (i = 0; i < 2; i++) {
+        for (j = 3; j >= 0; j--) {
+            *pbuf++ = hexdig[(surrogates[i] >> (j * 4)) & 0xF];
+        }
+    }
+    *pbuf++ = '>';
+    *pbuf = 0;
+
+    return pbuf;
+}
