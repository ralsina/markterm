diff --git a/src/hpdf_encoder.c b/src/hpdf_encoder.c
index 207afcd..ec4e25c 100644
--- a/src/hpdf_encoder.c
+++ b/src/hpdf_encoder.c
@@ -2598,10 +2598,69 @@ HPDF_CMapEncoder_InitAttr  (HPDF_Encoder  encoder)
     if (!encoder_attr->code_space_range)
         return encoder->error->error_no;
 
+    encoder_attr->alternate_map = HPDF_List_New (encoder->mmgr,
+                HPDF_DEF_ITEMS_PER_BLOCK);
+    if (!encoder_attr->alternate_map)
+        return encoder->error->error_no;
+
     return HPDF_OK;
 }
 
 
+HPDF_STATUS
+HPDF_SetEncoderAlternate  (HPDF_Encoder   encoder,
+                           HPDF_UINT32    codepoint,
+                           HPDF_UINT16    cid)
+{
+    HPDF_CMapEncoderAttr attr;
+    HPDF_AlternateUnicodeRec *entry;
+
+    if (!encoder || encoder->type != HPDF_ENCODER_TYPE_DOUBLE_BYTE)
+        return HPDF_INVALID_ENCODER;
+
+    attr = (HPDF_CMapEncoderAttr)encoder->attr;
+    if (!attr || !attr->alternate_map)
+        return HPDF_INVALID_ENCODER;
+
+    if (codepoint <= 0xFFFF)
+        return HPDF_INVALID_PARAMETER;
+
+    entry = HPDF_GetMem (encoder->mmgr, sizeof (HPDF_AlternateUnicodeRec));
+    if (!entry)
+        return encoder->error->error_no;
+
+    entry->codepoint = codepoint;
+    entry->cid = cid;
+
+    return HPDF_List_Add (attr->alternate_map, entry);
+}
+
+
+HPDF_UINT16
+HPDF_GetEncoderAlternate  (HPDF_Encoder   encoder,
+                           HPDF_UINT32    codepoint)
+{
+    HPDF_CMapEncoderAttr attr;
+    HPDF_UINT i;
+
+    if (!encoder)
+        return 0;
+
+    attr = (HPDF_CMapEncoderAttr)encoder->attr;
+    if (!attr || !attr->alternate_map)
+        return 0;
+
+    for (i = 0; i < attr->alternate_map->count; i++) {
+        HPDF_AlternateUnicodeRec *entry = HPDF_List_ItemAt (attr->alternate_map, i);
+
+        if (entry->codepoint == codepoint)
+            return entry->cid;
+    }
+
+    return 0;
+}
+
+
 HPDF_UNICODE
 HPDF_CMapEncoder_ToUnicode  (HPDF_Encoder  encoder,
                              HPDF_UINT16   code)
@@ -2667,6 +2726,18 @@ HPDF_CMapEncoder_Free  (HPDF_Encoder  encoder)
         HPDF_List_Free (attr->code_space_range);
     }
 
+    if (attr && attr->alternate_map) {
+        HPDF_AlternateUnicodeRec *alt;
+
+        for (i = 0; i < attr->alternate_map->count; i++) {
+            alt = HPDF_List_ItemAt (attr->alternate_map, i);
+
+            HPDF_FreeMem (encoder->mmgr, alt);
+        }
+
+        HPDF_List_Free (attr->alternate_map);
+    }
+
     HPDF_FreeMem (encoder->mmgr, encoder->attr);
     encoder->attr = NULL;
 }
