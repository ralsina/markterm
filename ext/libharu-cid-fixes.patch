+HPDF_UINT16
+HPDF_TTFontDef_GetGlyphidU32  (HPDF_FontDef   fontdef,
+                               HPDF_UINT32    code)
+{
+    HPDF_TTFontDefAttr attr = (HPDF_TTFontDefAttr)fontdef->attr;
+    HPDF_UINT lo = 0;
+    HPDF_UINT hi = attr->cmap_group_count;
+
+    /* only the format 12 cmap can address codepoints beyond the BMP */
+    if (!attr->cmap_groups)
+        return (code <= 0xFFFF) ? HPDF_TTFontDef_GetGlyphid (fontdef,
+                (HPDF_UINT16)code) : 0;
+
+    while (lo < hi) {
+        HPDF_UINT mid = lo + (hi - lo) / 2;
+        HPDF_TTF_CmapGroup *group = &attr->cmap_groups[mid];
+
+        if (code < group->start_char_code)
+            hi = mid;
+        else if (code > group->end_char_code)
+            lo = mid + 1;
+        else
+        {
+            HPDF_UINT16 gid = (HPDF_UINT16)(group->start_glyph_id +
+                    (code - group->start_char_code));
+
+            /* a lookup is a promise to draw: flag the glyph (and its
+             * components) for the embedded subset, the way GetCharWidth
+             * does for BMP codepoints */
+            if (gid < attr->num_glyphs && !attr->glyph_tbl.flgs[gid])
+            {
+                attr->glyph_tbl.flgs[gid] = 1;
+                CheckCompositGlyph (fontdef, gid);
+            }
+
+            return gid;
+        }
+    }
+
+    return 0;
+}
