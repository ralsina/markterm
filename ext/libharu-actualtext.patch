+/* BDC /Span with /ActualText: everything drawn until the matching
+   HPDF_Page_EndActualText carries the given UTF-8 text as its
+   alternate text, used by readers for copy, search and accessibility
+   in place of the drawn graphics. */
+HPDF_EXPORT(HPDF_STATUS)
+HPDF_Page_BeginActualText  (HPDF_Page    page,
+                            const char  *utf8_text);
+
+/* EMC: close the span opened by HPDF_Page_BeginActualText. */
+HPDF_EXPORT(HPDF_STATUS)
+HPDF_Page_EndActualText  (HPDF_Page  page);
+
