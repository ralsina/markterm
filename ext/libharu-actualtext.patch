diff --git a/src/hpdf_page_operator.c b/src/hpdf_page_operator.c
--- a/src/hpdf_page_operator.c
+++ b/src/hpdf_page_operator.c
@@ -2928,3 +2928,147 @@
 
     return ret;
 }
+
+/*--- Marked content with alternate text ----------------------------------*/
+
+/* /Span << /ActualText (...) >> BDC ... EMC marks the enclosed
+   operators as a span whose alternate text replaces the drawn
+   graphics when the PDF is copied, searched or read aloud. The text
+   is UTF-8 on input: printable ASCII goes out as an escaped literal
+   string, anything else as a UTF-16BE hex string with a BOM, which
+   every reader decodes the same way. */
+HPDF_EXPORT(HPDF_STATUS)
+HPDF_Page_BeginActualText  (HPDF_Page   page,
+                            const char  *utf8_text)
+{
+    HPDF_PageAttr attr;
+    HPDF_STATUS ret = HPDF_Page_CheckState (page, HPDF_GMODE_PAGE_DESCRIPTION);
+    HPDF_STATUS ok = HPDF_OK;
+    const unsigned char *p;
+    int ascii_only = 1;
+
+    HPDF_PTRACE ((" HPDF_Page_BeginActualText\n"));
+
+    if (ret != HPDF_OK)
+        return ret;
+
+    if (!utf8_text)
+        utf8_text = "";
+
+    for (p = (const unsigned char *)utf8_text; *p; p++) {
+        if (*p < 0x20 || *p > 0x7E) {
+            ascii_only = 0;
+            break;
+        }
+    }
+
+    attr = (HPDF_PageAttr)page->attr;
+
+    if (HPDF_Stream_WriteStr (attr->stream, "/Span << /ActualText ") != HPDF_OK)
+        return HPDF_CheckError (page->error);
+
+    if (ascii_only) {
+        ok = HPDF_Stream_WriteStr (attr->stream, "(");
+        for (p = (const unsigned char *)utf8_text; ok == HPDF_OK && *p; p++) {
+            if (*p == '\\' || *p == '(' || *p == ')') {
+                char escaped[3];
+                escaped[0] = '\\';
+                escaped[1] = (char)*p;
+                escaped[2] = '\0';
+                ok = HPDF_Stream_WriteStr (attr->stream, escaped);
+            } else {
+                char one[2];
+                one[0] = (char)*p;
+                one[1] = '\0';
+                ok = HPDF_Stream_WriteStr (attr->stream, one);
+            }
+        }
+        if (ok == HPDF_OK)
+            ok = HPDF_Stream_WriteStr (attr->stream, ")");
+    } else {
+        /* decode UTF-8 leniently (malformed sequences become U+FFFD)
+           and emit UTF-16BE, with surrogate pairs past the BMP */
+        static const char digits[] = "0123456789ABCDEF";
+        ok = HPDF_Stream_WriteStr (attr->stream, "<FEFF");
+        p = (const unsigned char *)utf8_text;
+        while (ok == HPDF_OK && *p) {
+            unsigned int cp;
+            unsigned int units[2];
+            int unit_count = 1;
+            int extra = 0;
+            int i;
+
+            if (*p < 0x80) {
+                cp = *p++;
+            } else if ((*p & 0xE0) == 0xC0) {
+                cp = (unsigned int)(*p++ & 0x1F);
+                extra = 1;
+            } else if ((*p & 0xF0) == 0xE0) {
+                cp = (unsigned int)(*p++ & 0x0F);
+                extra = 2;
+            } else if ((*p & 0xF8) == 0xF0) {
+                cp = (unsigned int)(*p++ & 0x07);
+                extra = 3;
+            } else {
+                cp = 0xFFFD;
+                p++;
+            }
+            while (extra > 0) {
+                if (!*p || (*p & 0xC0) != 0x80) {
+                    cp = 0xFFFD;
+                    break;
+                }
+                cp = (cp << 6) | (unsigned int)(*p++ & 0x3F);
+                extra--;
+            }
+
+            if (cp >= 0x10000) {
+                units[0] = 0xD800 + ((cp - 0x10000) >> 10);
+                units[1] = 0xDC00 + ((cp - 0x10000) & 0x3FF);
+                unit_count = 2;
+            } else {
+                units[0] = cp;
+            }
+
+            for (i = 0; i < unit_count && ok == HPDF_OK; i++) {
+                char hex[5];
+                hex[0] = digits[(units[i] >> 12) & 0xF];
+                hex[1] = digits[(units[i] >> 8) & 0xF];
+                hex[2] = digits[(units[i] >> 4) & 0xF];
+                hex[3] = digits[units[i] & 0xF];
+                hex[4] = '\0';
+                ok = HPDF_Stream_WriteStr (attr->stream, hex);
+            }
+        }
+        if (ok == HPDF_OK)
+            ok = HPDF_Stream_WriteStr (attr->stream, ">");
+    }
+
+    if (ok == HPDF_OK)
+        ok = HPDF_Stream_WriteStr (attr->stream, " >> BDC\012");
+
+    if (ok != HPDF_OK)
+        return HPDF_CheckError (page->error);
+
+    return ret;
+}
+
+/* EMC: close the span opened by HPDF_Page_BeginActualText. */
+HPDF_EXPORT(HPDF_STATUS)
+HPDF_Page_EndActualText  (HPDF_Page  page)
+{
+    HPDF_PageAttr attr;
+    HPDF_STATUS ret = HPDF_Page_CheckState (page, HPDF_GMODE_PAGE_DESCRIPTION);
+
+    HPDF_PTRACE ((" HPDF_Page_EndActualText\n"));
+
+    if (ret != HPDF_OK)
+        return ret;
+
+    attr = (HPDF_PageAttr)page->attr;
+
+    if (HPDF_Stream_WriteStr (attr->stream, "EMC\012") != HPDF_OK)
+        return HPDF_CheckError (page->error);
+
+    return ret;
+}
